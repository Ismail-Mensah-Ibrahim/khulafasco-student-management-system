# Environment Variables — Khulafasco Student Management System
#
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
#
# ---------------------------------------------------------------

# Supabase Project URL (from your Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon/Public Key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------
# SERVICE ROLE KEY — NEVER expose this to the browser.
# Only use in trusted server environments (e.g., admin scripts).
# Do NOT put this in NEXT_PUBLIC_ variables.
# ---------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
